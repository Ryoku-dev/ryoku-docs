{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ryoku",
  "description": "Ryoku is a Linux desktop built on Arch, CachyOS, Void or Fedora: one Quickshell desktop on Hyprland or niri, a guided installer, and signed packages for every edition. A riced daily driver with the ryoku CLI, wallpaper-driven theming and the Rashin agent.",
  "colors": {
    "primary": "#e2342a",
    "light": "#ef5b50",
    "dark": "#e2342a"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Fraunces"
    },
    "body": {
      "family": "Space Grotesk"
    }
  },
  "background": {
    "color": {
      "dark": "#100d08"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "favicon": "/assets/brand/favicon.png",
  "logo": {
    "light": "/assets/brand/wordmark-light.png",
    "dark": "/assets/brand/wordmark-dark.png"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://docs.ryoku.dev",
      "description": "Ryoku documentation: install, convert, configure and run the Ryoku desktop on Arch, CachyOS, Void or Fedora with Hyprland or niri.",
      "keywords": "Ryoku, Ryoku Linux, Arch Linux, CachyOS, Void Linux, Fedora, Hyprland, niri, Quickshell, Omarchy alternative, riced Linux desktop, ryoku CLI, Wayland",
      "og:site_name": "Ryoku Docs",
      "og:title": "Ryoku documentation",
      "og:image": "https://ryoku.dev/social-card.jpg",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://ryoku.dev/social-card.jpg"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Ryoku-dev/ryoku"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Ryoku-dev/ryoku",
      "website": "https://ryoku.dev"
    }
  },
